<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamClipRemuxer</AssemblyName>
    <RootNamespace>SteamClipRemuxer.Gui</RootNamespace>
    <Product>Steam Clip Remuxer</Product>
    <!-- Lets the solution build (and therefore be checked) on non-Windows hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Scale per monitor rather than once at launch. Without this a window dragged from a 4K
      display to a 1080p one is redrawn by the compositor and comes out blurred, which is the
      usual reason a WinForms app looks dated before anyone reads a word of it.
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The exe's own icon, shown by Explorer and pinned taskbar entries. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The same file again as a resource, for the windows' title bars and the running taskbar
      button. Read from the assembly rather than from the exe's Win32 icon, which is not
      reliably reachable from inside a single-file publish.
    -->
    <EmbeddedResource Include="Assets/app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SteamClipRemuxer.Core/SteamClipRemuxer.Core.csproj" />
  </ItemGroup>
</Project>
