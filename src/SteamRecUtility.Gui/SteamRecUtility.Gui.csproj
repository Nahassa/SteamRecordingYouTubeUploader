<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamRecUtility</AssemblyName>
    <RootNamespace>SteamRecUtility.Gui</RootNamespace>
    <Product>SteamRec Utility</Product>
    <!-- Lets the solution build (and therefore be checked) on non-Windows hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SteamRecUtility.Core/SteamRecUtility.Core.csproj" />
  </ItemGroup>
</Project>
